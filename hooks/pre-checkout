#!/usr/bin/env bash
# Trunk public v1 Buildkite agent hook: only configures Git auth before native checkout.
# Install only on an isolated, disposable Buildkite agent/queue.
set +x
set -euo pipefail

fail() { printf 'ENG-265 pre-checkout: %s\n' "$*" >&2; return 1; }

# Repository selection is Buildkite pipeline configuration (BUILDKITE_REPO),
# not an authorization grant or a value supplied separately to this plugin.
# A narrowly allowed host prevents accidentally sending job OIDC to arbitrary
# Git destinations; Trunk independently verifies the historical dispatch.
remote="${BUILDKITE_REPO:-}"
[[ "$remote" =~ ^https://([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?/v1/git/[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]*\.git$ ]] || {
  fail 'BUILDKITE_REPO must be one exact HTTPS Trunk Git repository URL'; return 1 2>/dev/null || exit 1;
}
gitHost="${remote#https://}"
gitHost="${gitHost%%/*}"
# Production works without any opt-in. Preview permits the two
# team-scoped deployment families and unscoped 48-hex Change aliases.
# This syntax check does not prove Vercel ownership. With Preview opted in,
# the operator trusts the configured Repository URL as a credential destination.
# No operator-supplied regex can widen this host boundary.
case "${ALLOW_TRUNK_PREVIEW:-false}" in
  true|false) ;;
  *) fail 'ALLOW_TRUNK_PREVIEW must be true or false'; return 1 2>/dev/null || exit 1 ;;
esac
if [[ "$gitHost" != 'api.trunk.dev' ]]; then
  [[ "${ALLOW_TRUNK_PREVIEW:-false}" == true && ( "$gitHost" =~ ^trunk-[a-z0-9-]+-balearic-labs\.vercel\.app$ || "$gitHost" =~ ^trunk-[a-z0-9-]+-trunk-dev\.vercel\.app$ || "$gitHost" =~ ^trunk-[0-9a-f]{48}\.vercel\.app$ ) ]] || {
    fail 'Git remote host is not an allowed Trunk Production/Preview hostname'; return 1 2>/dev/null || exit 1;
  }
fi
# Never use a caller-supplied audience, even if the legacy env name is set.
audience="https://${gitHost}/v1/git/buildkite"
# Branch/ref, lifecycle and commit selection are not plugin authorization gates.
# Preserve Buildkite's checkout inputs unchanged; Trunk authorizes Git reads
# using the token and durable server-side authority.
# A plugin option does not substitute for Buildkite's native checkout control.
# checkout=false requests no automatic source materialization, but still sets
# the job-local credential helper for possible command-phase Git reads.
case "${BUILDKITE_PLUGIN_TRUNK_GIT_AUTH_CHECKOUT:-true}" in
  true|false) ;;
  *) fail 'checkout plugin option must be true or false'; return 1 2>/dev/null || exit 1 ;;
esac
if [[ "${BUILDKITE_PLUGIN_TRUNK_GIT_AUTH_CHECKOUT:-true}" == false ]]; then
  export BUILDKITE_SKIP_CHECKOUT=true
fi
# A caller's own checkout.skip/BUILDKITE_SKIP_CHECKOUT remains authoritative.
# In that case this plugin must not re-enable the native checkout.
command -v git >/dev/null 2>&1 || { fail 'git is required'; return 1 2>/dev/null || exit 1; }
command -v buildkite-agent >/dev/null 2>&1 || { fail 'buildkite-agent is required'; return 1 2>/dev/null || exit 1; }

# Buildkite job shells inherit exported vars from pre-checkout. Do not store JWTs.
# Mint on every Git credential request; no global ~/.gitconfig edits.
urlHost="${remote#https://}"
urlHost="${urlHost%%/*}"
urlPath="${remote#https://$urlHost/}"
count="${GIT_CONFIG_COUNT:-0}"
[[ "$count" =~ ^[0-9]{1,2}$ ]] || { fail 'invalid Git config count'; return 1 2>/dev/null || exit 1; }
(( 10#$count < 90 )) || { fail 'too many Git config entries'; return 1 2>/dev/null || exit 1; }

umask 077
helperDir="$(mktemp -d "${TMPDIR:-/tmp}/trunk-byo-git.XXXXXXXX")" || {
  fail 'failed to allocate job-local helper'; return 1 2>/dev/null || exit 1;
}
cat > "$helperDir/credential-helper" <<'HELPER'
#!/usr/bin/env bash
set +x
set -euo pipefail
[[ "${1:-}" == 'get' ]] || exit 0
protocol='' host='' path=''
while IFS= read -r line; do
  [[ -n "$line" ]] || break
  case "$line" in
    protocol=*) protocol="${line#protocol=}" ;;
    host=*) host="${line#host=}" ;;
    path=*) path="${line#path=}" ;;
  esac
done
[[ "$protocol" == 'https' && "$host" == "${TRUNK_BUILDKITE_GIT_HOST:-}" && "$path" == "${TRUNK_BUILDKITE_GIT_PATH:-}" ]] || exit 0
# Buildkite omits optional build_id and pipeline_id claims unless requested.
# These identities bind the JWT to one historical Trunk BYO dispatch;
# the server still verifies signature, job, source, tenant and authorization.
jwt="$(buildkite-agent oidc request-token \
  --audience "$TRUNK_BUILDKITE_OIDC_AUDIENCE" \
  --claim build_id,pipeline_id)" || exit 1
[[ "$jwt" =~ ^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$ ]] || exit 1
printf 'username=trunk-byo\npassword=%s\n' "$jwt"
HELPER
chmod 700 "$helperDir/credential-helper"

export TRUNK_BUILDKITE_JOB_HELPER_DIR="$helperDir"
export TRUNK_BUILDKITE_GIT_HOST="$urlHost"
export TRUNK_BUILDKITE_GIT_PATH="$urlPath"
export TRUNK_BUILDKITE_OIDC_AUDIENCE="$audience"
export GIT_TERMINAL_PROMPT=0
export GIT_ASKPASS=false

# URL-specific Git helper: reset ambient helpers only for this repository.
# No token in Git URL, process args, file contents or global config.
index="$count"
add_git_config() {
  local key="$1" value="$2" keyName="GIT_CONFIG_KEY_$index" valueName="GIT_CONFIG_VALUE_$index"
  printf -v "$keyName" '%s' "$key"
  printf -v "$valueName" '%s' "$value"
  export "$keyName" "$valueName"
  index="$((index + 1))"
}
add_git_config "credential.${remote}.helper" ''
add_git_config "credential.${remote}.helper" "!${helperDir}/credential-helper"
add_git_config "credential.${remote}.useHttpPath" true
export GIT_CONFIG_COUNT="$index"
